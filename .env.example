# Copy to .env and adjust. .env is gitignored: never commit it.

NODE_ENV=development
LOG_LEVEL=info

# Postgres from docker compose. If the port is reachable from your network (e.g. Docker on
# another machine), use a long random password.
POSTGRES_USER=driving
POSTGRES_PASSWORD=change-me
POSTGRES_DB=driving_school
POSTGRES_PORT=54329
DATABASE_URL=postgres://driving:change-me@localhost:54329/driving_school
# Integration tests connect here and create throwaway ds_test_* databases on the same server.
TEST_DATABASE_URL=postgres://driving:change-me@localhost:54329/postgres

# Firestore emulator. The demo- prefix means no real Google project and no credentials.
FIREBASE_PROJECT_ID=demo-driving-school
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Real-project mode only: a service-account JSON kept OUTSIDE this repo.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/the/repo/service-account.json

# API
HOST=127.0.0.1
PORT=3000
BOOKINGS_READ_SOURCE=firestore
